<%- include('partials/head', { title: 'Alege o parola noua' }) %>

<section class="card form-card">
  <h1>Alege o parola noua</h1>

  <% if (error) { %>
    <div class="flash flash-error"><%= error %></div>
  <% } %>

  <% if (user) { %>
    <p class="muted">Setezi o parola noua pentru contul <strong><%= user.email %></strong>.</p>

    <form method="post" class="stack">
      <label>
        <span>Parola noua</span>
        <input type="password" name="password" required>
      </label>

      <button class="button" type="submit">Salveaza parola</button>
    </form>
  <% } %>
</section>

<%- include('partials/foot') %>
