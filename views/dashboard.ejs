<%- include('partials/head', { title: 'Contul meu' }) %>

<section class="card">
  <h1>Bun venit, <%= user.email %></h1>
  <p>Esti conectat cu rolul <strong><%= user.role %></strong>.</p>

  <div class="info-grid">
    <div>
      <span class="label">ID utilizator</span>
      <strong><%= user.id %></strong>
    </div>
    <div>
      <span class="label">Data crearii</span>
      <strong><%= user.created_at %></strong>
    </div>
    <div>
      <span class="label">Cookie de sesiune</span>
      <strong><%= sessionInfo.cookieName %></strong>
    </div>
    <div>
      <span class="label">Durata sesiunii</span>
      <strong><%= sessionInfo.maxAgeDays %> zile</strong>
    </div>
    <div>
      <span class="label">Tichete create</span>
      <strong><%= ticketCount %></strong>
    </div>
  </div>
</section>

<section class="grid">
  <article class="card">
    <div class="section-head">
      <h2>Tichete recente</h2>
      <a class="button button-secondary" href="/tickets">Vezi toate tichetele</a>
    </div>

    <% if (recentTickets.length === 0) { %>
      <p class="muted">Nu ai creat inca niciun tichet.</p>
    <% } else { %>
      <ul class="simple-list">
        <% recentTickets.forEach((ticket) => { %>
          <li>
            <strong><%= ticket.title %></strong>
            <span class="muted"><%= ticket.severity %> • <%= ticket.status %></span>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </article>

  <article class="card">
    <h2>Activitate recenta</h2>

    <% if (recentLogs.length === 0) { %>
      <p class="muted">Nu exista inca evenimente in jurnal.</p>
    <% } else { %>
      <ul class="simple-list">
        <% recentLogs.forEach((log) => { %>
          <li>
            <strong><%= log.action %></strong>
            <span class="muted"><%= log.resource %> • <%= log.timestamp %></span>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </article>
</section>

<section class="card">
  <form method="post" action="/logout">
    <button class="button button-secondary" type="submit">Deconectare</button>
  </form>
</section>

<%- include('partials/foot') %>
