<%- include('partials/head', { title: 'Am uitat parola' }) %>

<section class="card form-card">
  <h1>Am uitat parola</h1>

  <% if (error) { %>
    <div class="flash flash-error"><%= error %></div>
  <% } %>

  <form method="post" class="stack">
    <label>
      <span>Email</span>
      <input type="email" name="email" value="<%= form.email %>" required>
    </label>

    <button class="button" type="submit">Trimite link de resetare</button>
  </form>

  <% if (resetPreview) { %>
    <div class="reset-preview">
      <h2>Mesaj de resetare</h2>
      <p><strong>Token de resetare:</strong> <code><%= resetPreview.token %></code></p>
      <p><strong>Link pentru resetarea parolei:</strong> <a href="<%= resetPreview.url %>"><%= resetPreview.url %></a></p>
    </div>
  <% } %>
</section>

<%- include('partials/foot') %>
